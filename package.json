{
  "name": "bingo-studio",
  "version": "1.0.1",
  "description": "Régie de bingo télé — saisie du boulier, habillage antenne, vérification des cartes",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win",
    "cartes": "node scripts/generer-cartes.mjs",
    "feuilles": "node scripts/feuilles-cartes.mjs",
    "sceller": "node scripts/sceller-base.mjs",
    "captures": "electron scripts/captures.cjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ca.bingostudio.app",
    "productName": "Bingo Studio",
    "copyright": "Bingo Studio — offert aux télévisions communautaires autonomes",
    "directories": {
      "output": "dist",
      "buildResources": "assets/icone"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "assets/musiques/**",
      "assets/sons/**",
      "data/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "assets/icone/icone.icns",
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Bingo Studio",
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icone/icone.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bingo Studio",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    }
  }
}
